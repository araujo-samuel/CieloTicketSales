<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Obrigatório no Android 11+ para detectar o serviço Cielo Smart instalado.
        Sem esta declaração o sistema não permite que o app detecte e envie intents
        para o pacote com.ads.lio.uriappclient.
        Ref: https://docs.cielo.com.br/cielo-smart/docs/configurando-o-android-manifest
    -->
    <queries>
        <package android:name="com.ads.lio.uriappclient" />
    </queries>

    <application
        android:name=".CieloTicketSalesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CieloTicketSales"
        tools:targetApi="31">

        <!-- Activity principal: hospeda toda a navegação Compose -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ResponseActivity: captura o retorno do Cielo Smart via Deep Link.
            Scheme "order" e host "response" devem coincidir com o urlCallback
            enviado na requisição de pagamento: "order://response"
        -->
        <activity
            android:name=".presentation.ResponseActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="order"
                    android:host="response" />
            </intent-filter>
        </activity>

    </application>

</manifest>
